{
  "name": "toobar",
  "version": "1.2.0",
  "description": "Toobar - Cross-platform video conferencing, messenger & file sharing (macOS, iPhone, iPad, Windows, Ubuntu, Android)",
  "main": "dist/main/index.js",
  "author": "Toobar Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/karan211-Bruno/toobar.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:signaling\"",
    "dev:main": "tsx watch src/main/index.ts",
    "dev:renderer": "vite",
    "dev:signaling": "tsx watch src/signaling/server.ts",
    "build": "node scripts/build-all.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build:signaling": "tsc -p tsconfig.signaling.json",
    "start": "electron dist/main/index.js",
    "pack": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "dist:mac": "node scripts/build-mac-installer.mjs",
    "dist:win": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64",
    "dist:linux": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux --x64 && node scripts/build-deb.mjs",
    "dist:ios": "python3 scripts/build-ios.py",
    "dist:android": "node scripts/build-android.mjs",
    "dist:all": "npm run build && npm run dist:mac && npm run dist:win && npm run dist:linux && npm run dist:ios && npm run dist:android",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "uuid": "^10.0.0",
    "webrtc-adapter": "^9.0.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^32.3.3",
    "electron-builder": "^25.0.0",
    "oxlint": "^1.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.toobar.app",
    "productName": "Toobar",
    "asarUnpack": [
      "public/**/*"
    ],
    "protocols": [
      {
        "name": "Toobar Meeting Link",
        "schemes": [
          "toobar"
        ]
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/.cache/**/*",
      "!node_modules/.bin/**/*",
      "!node_modules/typescript/**/*",
      "!node_modules/tsx/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/@electron/rebuild/**/*"
    ],
    "mac": {
      "category": "public.app-category.video",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.icns",
      "extendInfo": {
        "NSCameraUsageDescription": "화상 회의에서 내 카메라 영상을 상대방에게 전송하기 위해 카메라 접근 권한이 필요합니다.",
        "NSMicrophoneUsageDescription": "화상 회의에서 음성 대화를 나누기 위해 마이크 접근 권한이 필요합니다."
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Toobar",
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "executableArgs": [
        "--no-sandbox",
        "--disable-gpu-sandbox"
      ],
      "category": "AudioVideo",
      "maintainer": "Toobar Team <support@toobar.app>",
      "icon": "public/icon.png"
    }
  }
}
